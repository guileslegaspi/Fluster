@model OnlineMarketplace.Models.OrderModel

@{
    ViewData["Title"] = "Pay Now";
}

<div class="container py-4">
    <h2>Pay for Order #@Model.OrderId</h2>

    <p>
        This order is still awaiting payment.
    </p>

    <hr />

    <h5>Order Details</h5>

    @foreach (var detail in Model.Details)
    {
        <div class="mb-2">
            <strong>@detail.Product?.ProductName</strong>
            <span>
                x @detail.Quantity
            </span>
        </div>
    }

    <div class="mt-3">
        <strong>Total:</strong>
        ₱@Model.TotalPrice.ToString("N2")
    </div>

    <div class="mt-4">

        <form asp-action="ContinuePayment"
              method="post"
              class="d-inline">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="orderId"
                   value="@Model.OrderId" />

            <button type="submit"
                    class="btn btn-primary">
                Continue to Payment
            </button>

        </form>

        <a asp-action="MyOrders"
           class="btn btn-secondary">
            Back to My Orders
        </a>

    </div>
</div>
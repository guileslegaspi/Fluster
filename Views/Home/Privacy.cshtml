@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h1 class="fw-bold mb-3">Privacy Policy</h1>

            <p class="text-muted mb-4">
                This page explains how information is handled within Fluster.
            </p>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h5 class="fw-bold">Information We Collect</h5>
                    <p class="text-secondary">
                        Fluster may collect information provided during account
                        registration, profile management, product listings,
                        orders, and marketplace interactions.
                    </p>

                    <h5 class="fw-bold mt-4">Account Information</h5>
                    <p class="text-secondary">
                        Account information such as your username, email
                        address, contact details, and profile information is
                        used to provide marketplace functionality.
                    </p>

                    <h5 class="fw-bold mt-4">Orders & Payments</h5>
                    <p class="text-secondary">
                        Order information is stored to support checkout,
                        payment confirmation, order processing, shipping,
                        and order history. Payment processing is handled
                        through PayMongo.
                    </p>

                    <h5 class="fw-bold mt-4">Marketplace Communication</h5>
                    <p class="text-secondary">
                        Messages sent through Fluster's real-time chat feature
                        may be stored so buyers and sellers can communicate
                        regarding marketplace activity.
                    </p>

                    <h5 class="fw-bold mt-4">Portfolio Project Notice</h5>
                    <p class="text-secondary mb-0">
                        Fluster is a portfolio project created to demonstrate
                        full-stack web development using the .NET ecosystem.
                        It is not intended to represent a production
                        commercial marketplace or financial service.
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>
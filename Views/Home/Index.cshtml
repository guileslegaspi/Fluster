@model IEnumerable<OnlineMarketplace.Models.ProductModel>

@{
    ViewData["Title"] = "Fluster - Find It. Get It. Done.";

    var products = Model?.ToList()
        ?? new List<OnlineMarketplace.Models.ProductModel>();

    var featuredProduct = products.FirstOrDefault();
    var supportingProducts = products.Skip(1).Take(4).ToList();

}

<div class="container my-3 my-md-4">

    <!-- Featured on Fluster -->
    @if (featuredProduct != null)
    {
        <div class="d-flex align-items-center
                    justify-content-between mb-3">

            <h5 class="fw-bold m-0"
                style="color: var(--fluster-dark);">
                Featured on Fluster
            </h5>

            <small class="text-muted extra-small">
                Discover something worth checking out
            </small>

        </div>

        <div class="row g-3 g-md-4 mb-5">

            <!-- Featured Product -->
            <div class="col-lg-7">

                <div class="card border-0 shadow-sm
                            rounded-4 overflow-hidden
                            h-100 featured-card">

                    <div class="row g-0 h-100">

                        <!-- Featured Image -->
                        <div class="col-md-6">

                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@featuredProduct.ProductId"
                               class="text-decoration-none">

                                <div class="bg-light d-flex
                                            align-items-center
                                            justify-content-center"
                                     style="height: 100%;
                                            min-height: 300px;">

                                    @if (!string.IsNullOrWhiteSpace(
                                                                    featuredProduct.Image))
                                    {
                                        <img src="@featuredProduct.Image"
                                             alt="@featuredProduct.ProductName"
                                             class="w-100 h-100"
                                             style="object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <div class="text-muted text-center">

                                            <div style="font-size: 2.5rem;">
                                                🖼️
                                            </div>

                                            <div class="small">
                                                No image available
                                            </div>

                                        </div>
                                    }

                            </div>

                        </a>

                    </div>

                    <!-- Featured Information -->
                    <div class="col-md-6">

                        <div class="card-body p-4
                                    d-flex flex-column h-100">

                            <div class="mb-3">

                                <span class="badge
                                             bg-light
                                             text-dark
                                             border
                                             rounded-pill
                                             px-3 py-2">

                                    @(string.IsNullOrEmpty(
                                                                        featuredProduct.Category)
                                                                        ? "General"
                                                                        : featuredProduct.Category)

                                </span>

                                </div>

                                <div class="small text-muted mb-2">
                                    Featured listing
                                </div>

                                <h3 class="fw-bold mb-2">
                                    @featuredProduct.ProductName
                                </h3>

                                <p class="text-muted small mb-3
                                          product-featured-description">

                                    @featuredProduct.ProductDescription

                                </p>

                                <div class="mt-auto">

                                    <div class="d-flex
                                                justify-content-between
                                                align-items-center
                                                mb-3">

                                        <span class="fw-bold fs-4">
                                            ₱@featuredProduct.Price.ToString("N2")
                                        </span>

                                        <span class="small text-muted">
                                            Stock: @featuredProduct.Stock
                                        </span>

                                    </div>

                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@featuredProduct.ProductId"
                                       class="btn btn-warning
                                              fw-bold
                                              text-dark
                                              w-100
                                              rounded-3">

                                        View Product

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Supporting Featured Products -->
            <div class="col-lg-5">

                <div class="row row-cols-2 g-3 h-100">

                @foreach (var item in supportingProducts)
                    {
                        <div class="col">

                            <div class="card border-0 shadow-sm
                                            rounded-4 overflow-hidden
                                            h-100 featured-card">

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="text-decoration-none text-dark">

                                    <div class="bg-light"
                                         style="height: 135px;">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        item.Image))
                                        {
                                            <img src="@item.Image"
                                                 alt="@item.ProductName"
                                                 class="w-100 h-100"
                                                 style="object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <div class="d-flex
                                                                align-items-center
                                                                justify-content-center
                                                                h-100
                                                                text-muted">

                                                No Image

                                            </div>
                                        }

                            </div>

                        </a>

                        <div class="card-body p-3
                                        d-flex flex-column">

                            <span class="text-muted
                                             text-uppercase mb-1"
                                  style="font-size: 0.65rem;">

                                @(string.IsNullOrEmpty(item.Category)
                                                                ? "General"
                                                                : item.Category)

                            </span>

                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="text-decoration-none text-dark">

                                        <h6 class="fw-bold
                                                       text-truncate mb-2"
                                            title="@item.ProductName">

                                            @item.ProductName

                                        </h6>

                                    </a>

                                    <div class="mt-auto">

                                        <div class="fw-bold">
                                            ₱@item.Price.ToString("N2")
                                        </div>

                                        <div class="small text-muted">
                                            Stock: @item.Stock
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                                }

                </div>

            </div>

        </div>
    }


    <!-- Browse the Marketplace -->
    @if (products.Count > 1)
    {
        <div class="d-flex align-items-center
                    justify-content-between mb-3">

            <h5 class="fw-bold m-0"
                style="color: var(--fluster-dark);">

                Browse the Marketplace

            </h5>

            <small class="text-muted extra-small">
                More listings
            </small>

        </div>

        <div class="row row-cols-2 row-cols-sm-3
                    row-cols-md-4 row-cols-lg-5
                    g-2 g-md-3 mb-5">

            @foreach (var item in products.Skip(5))
            {
                <div class="col">

                    <div class="card h-100 border-0 shadow-sm
                                    fluster-card overflow-hidden">

                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@item.ProductId"
                           class="text-decoration-none text-dark">

                            <div class="position-relative"
                                 style="height: 140px;
                                            background-color: #f0f0f0;">

                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <img src="@item.Image"
                                         class="w-100 h-100"
                                         style="object-fit: cover;"
                                         alt="@item.ProductName">
                                }
                                else
                                {
                                    <div class="w-100 h-100
                                                        d-flex
                                                        align-items-center
                                                        justify-content-center
                                                        text-muted">

                                        No Image

                                    </div>
                                }

                            <span class="position-absolute
                                             top-0 end-0
                                             bg-dark text-white
                                             px-2 py-1 m-1
                                             rounded-2 opacity-75"
                                  style="font-size: 0.65rem;">

                                @(string.IsNullOrEmpty(item.Category)
                                                            ? "General"
                                                            : item.Category)

                        </span>

                            </div>

                        </a>

                        <div class="card-body p-2
                                        d-flex flex-column
                                        justify-content-between">

                            <div>

                                <small class="text-muted d-block
                                                  text-truncate"
                                       style="font-size: 0.7rem;">

                                    Listed by:
                                    <strong>
                                        @(item.Seller?.UserName ?? "Seller")
                                    </strong>

                                </small>

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="text-decoration-none text-dark">

                                    <h6 class="card-title
                                                   text-truncate
                                                   fw-bold mb-1 mt-1"
                                        style="font-size: 0.85rem;"
                                        title="@item.ProductName">

                                        @item.ProductName

                                    </h6>

                                </a>

                                <p class="card-text text-muted
                                              text-truncate mb-2"
                                   style="font-size: 0.7rem;">

                                    @item.ProductDescription

                                </p>

                            </div>

                            <div>

                                <div class="d-flex
                                                align-items-center
                                                justify-content-between
                                                mb-2">

                                    <span class="fluster-price"
                                          style="font-size: 0.95rem;">

                                        ₱@item.Price.ToString("N2")

                                    </span>

                                    <span class="badge
                                                     bg-light
                                                     text-dark
                                                     border p-1"
                                          style="font-size: 0.65rem;">

                                        Stock: @item.Stock

                                    </span>

                                </div>

                                <div class="d-grid gap-1">

                                    <a asp-controller="Purchasing"
                                       asp-action="Checkout"
                                       asp-route-productId="@item.ProductId"
                                       class="btn btn-fluster-amber
                                                  btn-sm rounded-3 py-1
                                                  text-white text-center
                                                  text-decoration-none fw-bold"
                                       style="font-size: 0.75rem;">

                                        Buy Now

                                    </a>

                                    <form asp-controller="Purchasing"
                                          asp-action="AddToCart"
                                          method="post"
                                          class="d-grid">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />

                                        <input type="hidden"
                                               name="productQuantity"
                                               value="1" />

                                        <button type="submit"
                                                class="btn btn-outline-dark
                                                           btn-sm rounded-3 py-1"
                                                style="font-size: 0.75rem;">

                                            Add to Cart

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
                }

        </div>
    }


    <!-- Marketplace Introduction -->
    <div class="p-3 p-md-4 rounded-4 bg-light border mb-5"
         style="font-size: 0.85rem; line-height: 1.6;">

        <h6 class="fw-bold mb-2"
            style="color: var(--fluster-dark);">

            FLUSTER PHILIPPINES – A FULL-STACK MARKETPLACE PROJECT

        </h6>

        <p class="text-muted extra-small mb-4">

            Fluster is an online marketplace built around a simple idea:
            when you need something, you shouldn't have to spend the day
            visiting different stores to find it. Discover products from
            independent sellers, connect with them directly, and complete
            your purchase from one convenient platform.

        </p>

        <div class="row g-3">

            <div class="col-12 col-md-4">

                <h6 class="fw-bold text-dark mb-1"
                    style="font-size: 0.8rem;">

                    ⚡ Find What You Need

                </h6>

                <p class="text-muted extra-small m-0">

                    Browse products from different sellers and discover what
                    you're looking for without having to visit multiple
                    physical shops.

                </p>

            </div>

            <div class="col-12 col-md-4">

                <h6 class="fw-bold text-dark mb-1"
                    style="font-size: 0.8rem;">

                    💬 Ask & Connect

                </h6>

                <p class="text-muted extra-small m-0">

                    Chat directly with sellers in real time, ask questions,
                    and get the information you need before placing an order.

                </p>

            </div>

            <div class="col-12 col-md-4">

                <h6 class="fw-bold text-dark mb-1"
                    style="font-size: 0.8rem;">

                    🛒 From Search to Checkout

                </h6>

                <p class="text-muted extra-small m-0">

                    Go from product discovery to checkout and follow your order
                    as it moves through payment, processing, shipping, and
                    completion.

                </p>

            </div>

        </div>

    </div>


    <!-- Why Fluster -->
    <div class="p-3 p-md-4 rounded-4 border mb-5"
         style="font-size: 0.85rem; line-height: 1.7;">

        <h6 class="fw-bold mb-2"
            style="color: var(--fluster-dark);">

            WHY FLUSTER?

        </h6>

        <p class="text-muted mb-3">

            Fluster started with a simple feeling:
            <strong>you need something, and you need it now.</strong>

        </p>

        <p class="text-muted mb-3">

            The original concept was inspired by the Filipino idea of
            <em>aligaga</em> — that restless, can't-wait feeling when you're
            looking for something you need. Instead of going from shop to shop
            trying to find it, Fluster brings the marketplace to you.

        </p>

        <div class="fw-semibold text-dark">

            Find it. Ask about it. Buy it. Done.

        </div>

    </div>

</div>

<style>
    .product-featured-description {
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .featured-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .featured-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12) !important;
        }
</style>
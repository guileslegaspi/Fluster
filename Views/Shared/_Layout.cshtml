@using Microsoft.AspNetCore.Http

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Fluster</title>

    <link rel="icon"
          type="image/svg+xml"
          href="~/favicon.svg" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/OnlineMarketplace.styles.css"
          asp-append-version="true" />

</head>

<body>

    
    <header>

        <nav class="navbar navbar-expand-lg custom-navbar">

            <div class="container-fluid d-flex
                    align-items-center
                    justify-content-between">

                
                <a class="navbar-brand text-light fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    FLUSTER

                </a>


                
                <div class="dropdown d-lg-none">

                    <button class="btn btn-outline-light btn-sm
                               dropdown-toggle
                               d-flex align-items-center gap-1"
                            type="button"
                            id="mobileNavDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        ☰ Menu

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow"
                        aria-labelledby="mobileNavDropdown">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Home"
                               asp-action="Index">

                                Browse

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item fw-bold text-warning"
                               asp-controller="Product"
                               asp-action="CreateProduct">

                                + Sell Item

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Purchasing"
                               asp-action="Cart">

                                Cart

                            </a>
                        </li>


                        @if (Context.Session.GetString("UserId") != null)
                        {
                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Profile">

                                    Profile

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Purchasing"
                                   asp-action="MyOrders">

                                    My Orders

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Purchasing"
                                   asp-action="MySales">

                                    My Sales

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Product"
                                   asp-action="MyListings">

                                    My Listings

                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                    Logout

                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>
                            </li>
                        }

                    </ul>

                </div>


                
                <div class="collapse navbar-collapse d-none d-lg-flex"
                     id="mainNavbar">


                    
                    <form class="d-flex w-100
                             my-2 my-lg-0
                             mx-lg-auto
                             search-bar"
                          asp-controller="Home"
                          asp-action="Index"
                          method="get">

                        @{
                            var selectedCatsForSearch =
                            ViewBag.SelectedCategories as List<string>
                            ?? new List<string>();

                            for (int i = 0;
                            i < selectedCatsForSearch.Count;
                            i++)
                            {
                                <input type="hidden"
                                       name="categories[@i]"
                                       value="@selectedCatsForSearch[i]" />
                            }
                        }

                        <input class="form-control me-2"
                               type="search"
                               name="searchQuery"
                               value="@ViewBag.SearchQuery"
                               placeholder="Search products..."
                               aria-label="Search" />

                        <button class="btn btn-search"
                                type="submit">

                            Search

                        </button>

                    </form>


                    
                    <ul class="navbar-nav ms-auto
                           mb-2 mb-lg-0
                           align-items-center">

                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-controller="Home"
                               asp-action="Index">

                                Browse

                            </a>

                        </li>


                        <li class="nav-item me-2">

                            <a class="btn btn-warning
                                  btn-sm
                                  fw-bold
                                  px-3
                                  text-dark"
                               asp-controller="Product"
                               asp-action="CreateProduct">

                                + Sell Item

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-controller="Purchasing"
                               asp-action="Cart">

                                Cart

                            </a>

                        </li>


                        @if (Context.Session.GetString("UserId") != null)
                        {
                            var userPic =
                            Context.Session.GetString("UserProfilePic");

                            var userName =
                            Context.Session.GetString("UserName") ?? "U";


                            
                            <li class="nav-item dropdown">

                                <a class="nav-link
                                          dropdown-toggle
                                          text-light
                                          d-flex
                                          align-items-center
                                          gap-2"
                                   href="#"
                                   id="userDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    @if (!string.IsNullOrEmpty(userPic))
                                    {
                                        <img src="@userPic"
                                             alt="Avatar"
                                             class="rounded-circle
                                                        border border-2
                                                        border-light"
                                             style="width: 28px;
                                                        height: 28px;
                                                        object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary
                                                        text-white
                                                        rounded-circle
                                                        d-flex
                                                        align-items-center
                                                        justify-content-center
                                                        fw-bold
                                                        border border-2
                                                        border-light"
                                             style="width: 28px;
                                                        height: 28px;
                                                        font-size: 0.75rem;">

                                            @userName[0].ToString().ToUpper()

                                        </div>
                                    }

                                    <span>My Account</span>

                                </a>


                                <ul class="dropdown-menu dropdown-menu-end"
                                    aria-labelledby="userDropdown">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">

                                            Profile

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Purchasing"
                                           asp-action="MyOrders">

                                            My Orders

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Purchasing"
                                           asp-action="MySales">

                                            My Sales

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Product"
                                           asp-action="MyListings">

                                            My Listings

                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">

                                            Logout

                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link text-light"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-light"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    
    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    
    <footer class="fluster-footer py-5">

        <div class="container">

            <div class="row g-4">


                
                <div class="col-12 col-md-5">

                    <h4 class="fw-bold mb-3">
                        FLUSTER
                    </h4>

                    <p class="text-secondary mb-3">

                        A community marketplace for buying and selling
                        products in a simple and convenient way.

                    </p>

                    <div class="small text-secondary">

                        Built with ASP.NET Core MVC,
                        PostgreSQL, PayMongo & SignalR.

                    </div>

                </div>


                
                <div class="col-6 col-md-3">

                    <h6 class="fw-bold text-uppercase mb-3">
                        Marketplace
                    </h6>

                    <ul class="list-unstyled
                           d-flex flex-column gap-2">

                        <li>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="text-decoration-none
                                  text-secondary">

                                Browse Products

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Product"
                               asp-action="CreateProduct"
                               class="text-decoration-none
                                  text-secondary">

                                Sell an Item

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Purchasing"
                               asp-action="Cart"
                               class="text-decoration-none
                                  text-secondary">

                                Cart

                            </a>

                        </li>


                        @if (Context.Session.GetString("UserId") != null)
                        {
                            <li>

                                <a asp-controller="Purchasing"
                                   asp-action="MyOrders"
                                   class="text-decoration-none
                                          text-secondary">

                                    My Orders

                                </a>

                            </li>

                            <li>

                                <a asp-controller="Purchasing"
                                   asp-action="MySales"
                                   class="text-decoration-none
                                          text-secondary">

                                    My Sales

                                </a>

                            </li>

                            <li>

                                <a asp-controller="Product"
                                   asp-action="MyListings"
                                   class="text-decoration-none
                                          text-secondary">

                                    My Listings

                                </a>

                            </li>
                        }

                    </ul>

                </div>


                
                <div class="col-6 col-md-4">

                    <h6 class="fw-bold text-uppercase mb-3">
                        About the Project
                    </h6>

                    <p class="text-secondary small mb-3">

                        Fluster is a portfolio marketplace application
                        built to demonstrate full-stack web development
                        using the .NET ecosystem.

                    </p>


                    <div class="d-flex flex-wrap gap-2">

                        <span class="badge
                                 bg-light
                                 text-dark
                                 border">

                            C#

                        </span>

                        <span class="badge
                                 bg-light
                                 text-dark
                                 border">

                            ASP.NET Core

                        </span>

                        <span class="badge
                                 bg-light
                                 text-dark
                                 border">

                            EF Core

                        </span>

                        <span class="badge
                                 bg-light
                                 text-dark
                                 border">

                            PostgreSQL

                        </span>

                        <span class="badge
                                 bg-light
                                 text-dark
                                 border">

                            SignalR

                        </span>

                        <span class="badge
                                 bg-light
                                 text-dark
                                 border">

                            PayMongo

                        </span>

                    </div>


                    <div class="mt-3">

                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="text-decoration-none
                              text-secondary
                              small">

                            Privacy Policy

                        </a>

                    </div>

                </div>

            </div>


            <hr class="my-4
                   text-muted
                   opacity-25" />


            
            <div class="d-flex flex-column
                    flex-md-row
                    justify-content-between
                    align-items-center
                    gap-2
                    small
                    text-secondary">

                <div>
                    © 2026 Fluster. All rights reserved.
                </div>

                <div>
                    Built as a portfolio project by Guiles Legaspi.
                </div>

            </div>

        </div>

    </footer>


   
    @await Html.PartialAsync("_ChatWidgetPartial")


    
    <div class="modal fade"
         id="confirmationModal"
         tabindex="-1"
         aria-labelledby="confirmationModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="confirmationModalLabel">

                        Confirm Action

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body"
                     id="confirmationModalMessage">

                    Are you sure?

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        No, Go Back

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="confirmationModalButton">

                        Yes, Continue

                    </button>

                </div>

            </div>

        </div>

    </div>


  
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
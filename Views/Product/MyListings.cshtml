@model IEnumerable<OnlineMarketplace.Models.ProductModel>

@{
    ViewData["Title"] = "My Listings";
}

<style>
    .product-description {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">My Listings</h2>
            <p class="text-muted mb-0">
                Manage the products you've listed on Fluster.
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="CreateProduct"
           class="btn btn-warning fw-bold px-4">
            + Create New Listing
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5 px-4">

                <div class="mb-3"
                     style="font-size: 3rem;">
                    📦
                </div>

                <h4 class="fw-bold mb-2">
                    No listings yet
                </h4>

                <p class="text-muted mb-4">
                    You haven't listed any products yet.
                    Start by adding your first item to the marketplace.
                </p>

                <a asp-controller="Product"
                   asp-action="CreateProduct"
                   class="btn btn-warning fw-bold px-4">
                    List Your First Item
                </a>

            </div>
        </div>
    }
    else
    {
        <!-- Listings -->
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">

                        <!-- Product Image -->
                        <div class="bg-light text-center"
                             style="height: 220px;">

                            @if (!string.IsNullOrWhiteSpace(item.Image))
                            {
                                <img src="@item.Image"
                                     alt="@item.ProductName"
                                     class="w-100 h-100"
                                     style="object-fit: contain;" />
                            }
                            else
                            {
                                <div class="d-flex
                                                        align-items-center
                                                        justify-content-center
                                                        h-100
                                                        text-muted">
                                    No Image
                                </div>
                            }

                        </div>

                        <!-- Product Details -->
                        <div class="card-body p-4 d-flex flex-column">

                            <div class="mb-2">
                                <span class="badge bg-light text-dark border">
                                    @item.Category
                                </span>
                            </div>

                            <h5 class="fw-bold mb-2">
                                @item.ProductName
                            </h5>

                            <p class="text-muted small mb-3 product-description">
                                @item.ProductDescription
                            </p>

                            <div class="mt-auto">

                                <div class="d-flex
                                                    justify-content-between
                                                    align-items-center
                                                    mb-3">

                                    <div>
                                        <div class="fw-bold fs-5">
                                            ₱@item.Price.ToString("N2")
                                        </div>

                                        <div class="text-muted small">
                                            Stock: @item.Stock
                                        </div>
                                    </div>

                                </div>

                                <div class="d-flex gap-2">

                                    <a asp-controller="Product"
                                       asp-action="EditProduct"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-outline-primary
                                                      btn-sm flex-grow-1">
                                        Edit
                                    </a>

                                    <form asp-controller="Product"
                                          asp-action="DeleteProduct"
                                          method="post"
                                          class="flex-grow-1"
                                          onsubmit="return confirm('Are you sure you want to delete @item.ProductName?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="Id"
                                               value="@item.ProductId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger
                                                               btn-sm w-100">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
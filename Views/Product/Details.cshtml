@model OnlineMarketplace.Models.ProductModel

@{
    ViewData["Title"] = Model.ProductName;

    var currentUserIdString = Context.Session.GetString("UserId");
    int? currentUserId = !string.IsNullOrEmpty(currentUserIdString)
        ? int.Parse(currentUserIdString)
        : null;

    bool isOwner = currentUserId.HasValue &&
                   Model.SellerId == currentUserId.Value;
}

<div class="container py-5">

    
    <div class="mb-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="text-decoration-none text-muted fw-semibold">
            ← Back to Products
        </a>
    </div>

    
    <div class="row g-4 g-lg-5">

        
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="bg-light d-flex
                            align-items-center
                            justify-content-center"
                     style="min-height: 520px;">

                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <img src="@Model.Image"
                             alt="@Model.ProductName"
                             class="img-fluid"
                             style="width: 100%;
                                        max-height: 520px;
                                        object-fit: contain;" />
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">

                            <div style="font-size: 3rem;">
                                🖼️
                            </div>

                            <div class="fw-semibold mt-2">
                                No image available
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


       
        <div class="col-lg-5">

            <div class="d-flex flex-column h-100">

                
                <div class="d-flex flex-wrap gap-2 mb-3">

                    <span class="badge bg-light text-dark border
                                 rounded-pill px-3 py-2">
                        @Model.Category
                    </span>

                    @if (Model.Stock > 0)
                    {
                        <span class="badge bg-success bg-opacity-10
                                         text-success rounded-pill px-3 py-2">
                            In Stock · @Model.Stock available
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10
                                         text-danger rounded-pill px-3 py-2">
                            Out of Stock
                        </span>
                    }

                </div>


                
                <h1 class="fw-bold display-5 mb-3">
                    @Model.ProductName
                </h1>


               
                <div class="fw-bold mb-4"
                     style="font-size: 2rem;">
                    ₱@Model.Price.ToString("N2")
                </div>


                <hr class="opacity-25 mb-4" />


                
                <div class="mb-4">

                    <div class="small text-muted
                                text-uppercase fw-bold mb-2">
                        Seller
                    </div>

                    <div class="d-flex
                                align-items-center
                                justify-content-between
                                gap-3
                                border rounded-4 p-3">

                        <div class="d-flex
                                    align-items-center
                                    gap-3">

                            @if (Model.Seller?.ProfilePicture != null &&
                                                        Model.Seller.ProfilePicture.Length > 0)
                            {
                                var base64Image =
                                Convert.ToBase64String(
                                Model.Seller.ProfilePicture);

                                var imageSrc =
                                $"data:image/png;base64,{base64Image}";

                                <img src="@imageSrc"
                                     alt="Seller"
                                     class="rounded-circle"
                                     style="width: 50px;
                                                height: 50px;
                                                object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-dark text-white
                                                rounded-circle
                                                d-flex
                                                align-items-center
                                                justify-content-center
                                                fw-bold"
                                     style="width: 50px;
                                                height: 50px;">

                                    @(Model.Seller?.UserName?[0]
                                                                    .ToString()
                                                                    .ToUpper() ?? "S")
                            </div>
                                                        }

                            <div>

                                <div class="fw-bold">
                                    @(Model.Seller?.UserName ?? "Seller")
                                </div>

                                <div class="small text-muted">
                                    Fluster Seller
                                </div>

                            </div>

                        </div>

                        @if (!isOwner)
                        {
                            <button type="button"
                                    class="btn btn-outline-dark
                                               btn-sm
                                               rounded-pill
                                               px-3
                                               fw-semibold"
                                    data-bs-toggle="modal"
                                    data-bs-target="#chatModal">
                                💬 Chat
                            </button>
                        }

                    </div>

                </div>


                
                <div class="mt-auto">

                    @if (isOwner)
                    {
                        <a asp-controller="Product"
                           asp-action="EditProduct"
                           asp-route-id="@Model.ProductId"
                           class="btn btn-dark
                                      btn-lg
                                      w-100
                                      rounded-3
                                      fw-bold">
                            Edit Listing
                        </a>
                    }
                    else if (Model.Stock > 0)
                    {
                        <div class="d-grid gap-2">

                            
                            <form asp-controller="Purchasing"
                                  asp-action="Checkout"
                                  method="get">

                                <input type="hidden"
                                       name="productId"
                                       value="@Model.ProductId" />

                                <input type="hidden"
                                       name="quantity"
                                       value="1" />

                                <button type="submit"
                                        class="btn btn-warning
                                                   btn-lg
                                                   w-100
                                                   rounded-3
                                                   fw-bold
                                                   text-dark">
                                    Buy Now
                                </button>

                            </form>


                           
                            <form asp-controller="Purchasing"
                                  asp-action="AddToCart"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="productId"
                                       value="@Model.ProductId" />

                                <input type="hidden"
                                       name="quantity"
                                       value="1" />

                                <button type="submit"
                                        class="btn btn-outline-dark
                                                   btn-lg
                                                   w-100
                                                   rounded-3
                                                   fw-bold">
                                    Add to Cart
                                </button>

                            </form>

                        </div>
                    }
                    else
                    {
                        <button class="btn btn-secondary
                                           btn-lg
                                           w-100
                                           rounded-3
                                           fw-bold"
                                disabled>
                            Currently Unavailable
                        </button>
                    }

                </div>

            </div>

        </div>

    </div>


    
    <div class="card border-0 shadow-sm rounded-4 mt-4 mt-lg-5">

        <div class="card-body p-4 p-md-5">

            <div class="small text-muted
                        text-uppercase fw-bold mb-2">
                About this item
            </div>

            <h4 class="fw-bold mb-3">
                Product Description
            </h4>

            <div class="product-description-scroll
                        border rounded-4 p-4 bg-light">

                <div class="text-secondary"
                     style="line-height: 1.8;
                            white-space: pre-line;">

                    @(string.IsNullOrWhiteSpace(Model.ProductDescription)
                                        ? "No description provided for this item."
                                        : Model.ProductDescription)

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    .product-description-scroll {
        max-height: 320px;
        overflow-y: auto;
    }

        .product-description-scroll::-webkit-scrollbar {
            width: 7px;
        }

        .product-description-scroll::-webkit-scrollbar-thumb {
            background: #adb5bd;
            border-radius: 10px;
        }

        .product-description-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
</style>



<div class="modal fade"
     id="chatModal"
     tabindex="-1"
     aria-labelledby="chatModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content rounded-4
                    border-0 shadow">

            <div class="modal-header
                        border-0 pb-0">

                <h5 class="modal-title fw-bold"
                    id="chatModalLabel">
                    Message @(Model.Seller?.UserName ?? "Seller")
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form id="sendMessageForm"
                  asp-controller="Chat"
                  asp-action="SendMessage"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="receiverId"
                       value="@Model.SellerId" />

                <input type="hidden"
                       name="productId"
                       value="@Model.ProductId" />

                <div class="modal-body py-3">

                    <div class="mb-3">

                        <label class="form-label
                                      text-muted
                                      small
                                      fw-bold">
                            YOUR MESSAGE
                        </label>

                        <textarea name="messageText"
                                  class="form-control rounded-3"
                                  rows="4"
                                  placeholder="Hi! Is this still available?"
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer
                            border-0 pt-0">

                    <button type="button"
                            class="btn btn-light
                                   rounded-pill
                                   px-4"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            id="sendMsgBtn"
                            class="btn btn-dark
                                   rounded-pill
                                   px-4
                                   fw-bold">
                        Send Message 🚀
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        document
            .getElementById("sendMessageForm")
            .addEventListener("submit", async function (e) {

                e.preventDefault();

                const form = this;

                const sendBtn =
                    document.getElementById("sendMsgBtn");

                const originalBtnText =
                    sendBtn.innerHTML;

                sendBtn.disabled = true;
                sendBtn.innerHTML = "Sending...";

                try {

                    const formData =
                        new FormData(form);

                    const response =
                        await fetch(form.action, {
                            method: "POST",
                            body: formData
                        });

                    const data =
                        await response.json();

                    if (data.success) {

                        const modalEl =
                            document.getElementById(
                                "chatModal"
                            );

                        const modal =
                            bootstrap.Modal.getInstance(
                                modalEl
                            ) ||
                            new bootstrap.Modal(modalEl);

                        modal.hide();

                        form.reset();

                        const sellerId =
                            "@Model.SellerId";

                        const sellerName =
                            "@Html.Raw(Model.Seller?.UserName ?? "Seller")";

                        if (
                            typeof window.openChatWithUser
                            === "function"
                        ) {
                            window.openChatWithUser(
                                sellerId,
                                sellerName
                            );
                        }

                    } else {

                        console.error(
                            "Failed to send message:",
                            data.message
                        );

                    }

                } catch (err) {

                    console.error(
                        "Chat error:",
                        err
                    );

                } finally {

                    sendBtn.disabled = false;
                    sendBtn.innerHTML =
                        originalBtnText;

                }

            });
    </script>
}